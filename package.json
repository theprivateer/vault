{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && npm run build:worker && npm run build:decryptor",
    "dev": "npm run build:worker && vite",
    "types": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench:argon2": "node benchmarks/argon2.mjs",
    "bench:vault": "vitest run --config vitest.bench.config.ts --disable-console-intercept",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:worker": "vite build --config vite.worker.config.ts",
    "build:decryptor": "vite build --config vite.decryptor.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inertiajs/vite": "^3.6.1",
    "@inertiajs/vue3": "^3.6.1",
    "@noble/ciphers": "2.3.0",
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "laravel-vite-plugin": "^3.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  }
}
