APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_SAME_SITE=strict
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Argon2id over the auth key. Slow on purpose: the auth key inherits only
# the password's entropy, not 256 bits. See docs/03-cryptographic-design.md
HASH_DRIVER=argon2id
ARGON_MEMORY=32768
ARGON_THREADS=1
ARGON_TIME=2

# Where the daily audit chain head is mailed. This is the only part of the audit
# log a compromised server cannot defeat — it can rewrite every row and recompute
# every hash, and it cannot reach into yesterday's inbox. That only holds if the
# address is genuinely elsewhere; a mailbox on the same host proves nothing.
#
# Unset, `vault:audit-anchor` fails loudly rather than reporting success while
# leaving the log with no external record at all.
VAULT_AUDIT_ANCHOR_ADDRESS=

# File attachments. `max_bytes` is capped because a download is reassembled in
# the browser; lifting it is the streaming-download work in docs/05, not a config
# change. The quota is per vault and counts stored ciphertext.
VAULT_FILES_DISK=local
VAULT_FILE_MAX_BYTES=104857600
VAULT_FILE_QUOTA_BYTES=1073741824

# How much of a secret's past is kept, for any vault that has not chosen its own
# policy. History recovers a value somebody pasted over by mistake; history of a
# value rotated *because it leaked* is a copy of the leaked value kept somewhere
# convenient. Neither direction is safe, so both numbers are deliberate.
#
# A vault can set 0 versions to turn history off entirely. The count is applied
# as an edit archives; the age is applied by `vault:history-prune` overnight.
VAULT_HISTORY_MAX_VERSIONS=20
VAULT_HISTORY_MAX_AGE_DAYS=180

# Key rotation reminders. A reminder and not a job: rotating a vault key needs a
# member's browser, since only a member can unwrap the current one, so nothing
# here could rotate on a timer even if it wanted to.
#
# Zero means never, and is the default on purpose. A rotation leaves every
# payload ciphertext untouched, so a calendar interval bounds how long a leaked
# Vault Key keeps opening things written *after* the leak — worth having when you
# think one escaped, close to ritual otherwise. The on-demand button is always
# there. `STALE_DAYS` is how long `vault:health` tolerates a re-key that a
# revocation demanded and nobody performed.
VAULT_ROTATE_AFTER_DAYS=0
VAULT_REKEY_STALE_DAYS=7

# One-time share links. The link key and the bearer token both live in the URL
# fragment, so the server stores a payload it cannot read and a hash it cannot
# reverse. These bound how long a credential can sit in somebody's chat history:
# an expiry is mandatory, and this is how far out it may be set.
VAULT_SHARE_LINK_DEFAULT_HOURS=24
VAULT_SHARE_LINK_MAX_HOURS=168
VAULT_SHARE_LINK_MAX_VIEWS=10
